#!/bin/bash

LOCK=" Lock"
LOGOUT="󰍃 Logout"
SUSPEND="󰤄 Suspend"
REBOOT="󰜉 Reboot"
SHUTDOWN="󰐥 Power Off"

CHOICE=$(printf "%s\n%s\n%s\n%s\n%s" "$LOCK" "$LOGOUT" "$SUSPEND" "$REBOOT" "$SHUTDOWN" | wofi --dmenu --prompt "Power Menu" --width 300 --height 300 --insensitive)

case "$CHOICE" in
    "$LOCK")
        hyprlock ;;
    "$LOGOUT")
	hyprshutdown -t 'Logging out...' ;;
    "$SUSPEND")
        systemctl suspend ;;
    "$REBOOT")
        hyprshutdown -t 'Rebooting...' -p 'systemctl reboot' ;;
    "$SHUTDOWN")
        hyprshutdown -t 'Powering off...' -p 'systemctl poweroff' ;;
esac
